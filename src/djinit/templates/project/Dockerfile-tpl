FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

# @IF database_type == 'mysql'
RUN apt-get update && apt-get install -y --no-install-recommends \
    default-libmysqlclient-dev \
    build-essential \
    pkg-config \
    && rm -rf /var/lib/apt/lists/*
# @ENDIF
# @IF database_type == 'postgresql'
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*
# @ENDIF

# @IF use_vite
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*
# @ENDIF

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

# @IF use_vite
RUN if [ -f package.json ]; then npm install && npm run build; fi
# @ENDIF
# @IF use_tailwind
RUN SECRET_KEY=build-only-secret-key DJANGO_SETTINGS_MODULE=[[ module_name ]].settings.development python manage.py tailwind build || true
# @ENDIF

RUN SECRET_KEY=build-only-secret-key DJANGO_SETTINGS_MODULE=[[ module_name ]].settings.development python manage.py collectstatic --noinput

# Run as non-root user
RUN useradd --create-home --shell /bin/bash appuser \
    && chown -R appuser:appuser /app
USER appuser

EXPOSE 8000

CMD ["gunicorn", "[[ module_name ]].wsgi:application", "--bind", "0.0.0.0:8000", "--workers", "3"]
