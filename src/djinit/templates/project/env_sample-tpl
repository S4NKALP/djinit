# Django settings
DJANGO_SETTINGS_MODULE=[[ project_name ]].settings.development
SECRET_KEY=your-secret-key
ALLOWED_HOSTS=api.your-domain.com,www.your-domain.com

# @IF use_database_url
# Database URL (recommended for production)
# @IF database_type == 'mysql'
DATABASE_URL=mysql://user:password@localhost:3306/[[ project_name ]]
# @ENDIF
# @IF database_type == 'postgresql'
DATABASE_URL=postgres://user:password@localhost:5432/[[ project_name ]]
# @ENDIF
# @IF database_type == 'sqlite3'
DATABASE_URL=sqlite:///db.sqlite3
# @ENDIF
# @ELSE
# Database (individual parameters)
# @IF database_type == 'sqlite3'
DB_NAME=db.sqlite3
# @ELSE
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=
# @ENDIF
# @ENDIF

# Frontend URL
FRONTEND_URL=https://frontend.your-domain.com,https://www.frontend.your-domain.com

# Email settings
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USE_TLS=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
SERVER_EMAIL=

# SEO settings (optional; defaults are preconfigured in settings/base.py)
SITE_NAME=[[ project_name ]]
SITE_DESCRIPTION=[[ project_name ]] - Built with Django and djinit.
