# @IF url_type == 'project'
"""generated with djinit"""

from django.contrib import admin
from django.contrib.sitemaps.views import sitemap
from django.http import HttpResponse
from django.urls import path, re_path
from django.conf import settings
from django.views.static import serve
# @IF include_api or include_apps
from django.urls import include
# @ENDIF
# @IF include_api
from rest_framework_simplejwt.views import (
    TokenObtainPairView,
    TokenRefreshView,
    TokenBlacklistView,
)
# @ENDIF
from .sitemaps import StaticViewSitemap

sitemaps = {
    "static": StaticViewSitemap,
}


def robots_txt(request):
    """Serve default robots.txt pointing crawlers to sitemap.xml."""
    sitemap_url = f"{request.scheme}://{request.get_host()}/sitemap.xml"
    lines = [
        "User-agent: *",
        "Allow: /",
        "Disallow: /admin/",
        "Disallow: /api/",
        f"Sitemap: {sitemap_url}",
    ]
    return HttpResponse("\n".join(lines), content_type="text/plain")


urlpatterns = [
    path("admin/", admin.site.urls),
    # SEO: sitemap.xml & robots.txt
    path("sitemap.xml", sitemap, {"sitemaps": sitemaps}, name="django.contrib.sitemaps.views.sitemap"),
    path("robots.txt", robots_txt, name="robots_txt"),
# @IF include_api
    # JWT tokens
    path("token/", TokenObtainPairView.as_view(), name="token_obtain_pair"),
    path("token/refresh/", TokenRefreshView.as_view(), name="token_refresh"),
    path("token/blacklist/", TokenBlacklistView.as_view(), name="token_blacklist"),
# @ENDIF
# @IF include_api and api_module and comment_out_api_url
    # path("api/", include("[[ api_module ]].urls")),
# @ENDIF
# @IF include_api and api_module and not comment_out_api_url
    path("api/", include("[[ api_module ]].urls")),
# @ENDIF
# @IF include_apps
    # App URLs
# @LOOP app in app_names
    path("", include("[[ app ]].urls")),
# @ENDLOOP
# @ENDIF
]

if settings.DEBUG:
    urlpatterns += [
        re_path(
            r"^media/(?P<path>.*)$",
            serve,
            {"document_root": settings.MEDIA_ROOT},
        ),
    ]
# @ENDIF
# @IF url_type == 'api_root'
