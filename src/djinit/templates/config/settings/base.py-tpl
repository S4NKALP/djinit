SOCIALACCOUNT_PROVIDERS = {}
for provider in (
# @LOOP provider in auth_providers
    "[[ provider ]]",
# @ENDLOOP
):
    client_id = env(f"{provider.upper()}_CLIENT_ID", default="")
    client_secret = env(f"{provider.upper()}_CLIENT_SECRET", default="")
    if client_id and client_secret:
        SOCIALACCOUNT_PROVIDERS[provider] = {
            "APPS": [{"client_id": client_id, "secret": client_secret}],
        }
# @IF "google" in auth_providers
